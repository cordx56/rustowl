#!/bin/sh -e

# config
DEFAULT_TOOLCHAIN_CHANNEL="1.99.0"
DEFAULT_RUST_COMPONENTS="rustc,rust-std,cargo,rustc-dev,llvm-tools $RUST_COMPONENTS"

# shared helpers (colors, host tuple, version gate). POSIX sh: this script runs
# under dash and busybox ash in CI, so the library avoids bash-only syntax.
# scripts/installer keeps its own copy of print_host_tuple because it is piped
# into `sh` from a URL and cannot source anything.
script_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/lib/common.sh
. "$script_dir/lib/common.sh"

# script start
export TOOLCHAIN_CHANNEL="${TOOLCHAIN_CHANNEL:-"$DEFAULT_TOOLCHAIN_CHANNEL"}"
INSTALL_COMPONENTS="${INSTALL_COMPONENTS:-"$DEFAULT_RUST_COMPONENTS"}"

print_toolchain() {
    echo "${TOOLCHAIN_CHANNEL}-$(print_host_tuple)"
}

TOOLCHAIN="$(print_toolchain)"
export TOOLCHAIN
RUSTOWL_TOOLCHAIN="$TOOLCHAIN"
export RUSTOWL_TOOLCHAIN
HOST_TUPLE="$(print_host_tuple)"
export HOST_TUPLE
export SYSROOT="${SYSROOT:-"$HOME/.rustowl/sysroot/$TOOLCHAIN"}"
export PATH="$SYSROOT/bin:$PATH"
export RUSTC_BOOTSTRAP="rustowlc"

DATE="$(echo "$TOOLCHAIN_CHANNEL" | awk 'match($0, /[0-9]+-[0-9]+-[0-9]+/) { print substr($0, RSTART, RLENGTH) }')"
export DATE

component_filename() {
    if [ "$1" = "rust-src" ]; then
        file_postfix=""
    else
        file_postfix="-${HOST_TUPLE}"
    fi
    if [ -z "$DATE" ]; then
        echo "$1-${TOOLCHAIN_CHANNEL}${file_postfix}"
    else
        echo "$1-nightly${file_postfix}"
    fi
}

DIST_BASE="https://static.rust-lang.org/dist"
download_component() {
    file_ext=".${2:-"tar.gz"}"
    if [ -z "$DATE" ]; then
        url="${DIST_BASE}/$(component_filename "$1")${file_ext}"
    else
        url="${DIST_BASE}/${DATE}/$(component_filename "$1")${file_ext}"
    fi

    curl -fsSL "$url" || {
        echo "Failed to download $url" 1>&2
        return 1
    }
}

# install_component <component> <sysroot-path>
# Note: success is recorded by the parent (install_toolchain) after wait,
# so concurrent workers never append to installed.txt themselves.
# All stages use explicit error checks rather than `set -e` propagation,
# since a failing pipeline does not reliably abort a background (&) job
# across /bin/sh implementations (dash, bash-as-sh, busybox ash).
install_component() {
    temp="$(mktemp -d)" || return 1
    if ! download_component "$1" | tar xzf - -C "$temp" > /dev/null; then
        echo "Component $1 failed to download or extract" 1>&2
        rm -rf "$temp"
        return 1
    fi

    component="$(component_filename "$1")"
    if [ ! -f "$temp/$component/components" ]; then
        echo "Component $1 has no components list" 1>&2
        rm -rf "$temp"
        return 1
    fi
    while IFS= read -r com || [ -n "$com" ]; do
        [ -z "$com" ] && continue
        base="$temp/$component/$com"
        if ! (cd "$base" && find . -type f | while IFS= read -r f || [ -n "$f" ]; do f="${f#./}"; mkdir -p "$2/$(dirname "$f")" && mv "$base/$f" "$2/$f" || exit 1; done); then
            echo "Component $1 failed to install files" 1>&2
            rm -rf "$temp"
            return 1
        fi
    done < "$temp/$component/components"

    rm -rf "$temp"
}
# install_toolchain <sysroot-path>
# Progress is printed by the parent only (single writer), so status lines
# never interleave mid-line the way per-worker chatter would. A fully
# cached sysroot stays silent.
install_toolchain() {
    mkdir -p "$1"
    touch "$1/installed.txt"

    components=$(printf '%s' "$INSTALL_COMPONENTS" | tr ',' ' ')
    pending=""
    total=0
    # shellcheck disable=SC2086
    for component in $components; do
        [ -z "$component" ] && continue
        if ! grep -qxF "$component" "$1/installed.txt"; then
            pending="$pending $component"
            total=$((total + 1))
        fi
    done
    if [ "$total" -eq 0 ]; then
        return 0
    fi

    echo "Fetching $total toolchain component(s)..." 1>&2
    pids=""
    starts=""
    n=0
    # shellcheck disable=SC2086
    for component in $pending; do
        n=$((n + 1))
        echo "== [$n/$total] fetching $component..." 1>&2
        install_component "$component" "$1" &
        pid=$!
        pids="$pids $pid:$component"
        starts="$starts $pid:$(date +%s)"
    done

    failed=""
    done_count=0
    # shellcheck disable=SC2086
    for entry in $pids; do
        pid=${entry%%:*}
        component=${entry#*:}
        start=""
        # shellcheck disable=SC2086
        for m in $starts; do
            case "$m" in
                "$pid:"*) start=${m#*:} ;;
            esac
        done
        if wait "$pid"; then
            done_count=$((done_count + 1))
            elapsed=$(( $(date +%s) - start ))
            echo "== [$done_count/$total] $component installed in ${elapsed}s" 1>&2
            # Single writer: only the parent records success, so concurrent
            # appends cannot interleave or duplicate entries.
            if ! grep -qxF "$component" "$1/installed.txt"; then
                echo "$component" >> "$1/installed.txt"
            fi
        else
            echo "!! $component FAILED" 1>&2
            failed="$failed $component"
        fi
    done

    if [ -n "$failed" ]; then
        echo "Failed components:$failed" 1>&2
        return 1
    fi
}

#
# main
#
install_toolchain "${SYSROOT}"
exec "$@"

